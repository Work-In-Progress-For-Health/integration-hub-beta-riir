SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
# A second subscription on the LIMS topic, a parallel copy of the LIMS traffic.
INGRESS_TOPIC_NAME="local-inthub-lims-transformer-ingress"
INGRESS_SUBSCRIPTION_NAME="local-inthub-lims-transformer-ingress-trrr-sub"
# Upstream sets "lims-soapserver" here, but the SOAP server publishes with session
# "lims-to-mpi" and a session-enabled subscription only yields its own session, so
# upstream's value receives nothing locally. Matched to the publisher instead.
INGRESS_SESSION_ID="lims-to-mpi"
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
RECEIVER_MLLP_HOST="mpi-hl7-topic-mock-receiver"
RECEIVER_MLLP_PORT=2581
WORKFLOW_ID="lims-to-trrr"
MICROSERVICE_ID="hl7_lims_trrr_sender"
ACK_TIMEOUT_SECONDS=5
HEALTH_BOARD="WLIMS"
PEER_SERVICE="TRRR"
MAX_MESSAGES_PER_MINUTE=30
