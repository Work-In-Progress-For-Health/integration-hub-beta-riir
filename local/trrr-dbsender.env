# The generic db-sender configured as upstream's db_sender_trrr, NHS-ID-update instance
# (spec/10-senders.md section 7.10; upstream #458): A31 and A40 from the LIMS topic, as the
# three parameters of dbo.TRRRIDUpdate. `.secrets` supplies MSSQL_SA_PASSWORD, which this
# uses as the `sa` password.
SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
INGRESS_TOPIC_NAME="local-inthub-lims-hl7-input"
INGRESS_SUBSCRIPTION_NAME="local-inthub-lims-trrr-db-sender-sub"
INGRESS_SESSION_ID="lims-soapserver"

DB_SERVER="sqledge"
DB_PORT=1433
DB_NAME="Clinical_Results"
DB_STORED_PROCEDURE="dbo.TRRRIDUpdate"
DB_PROCEDURE_TYPE="trrr"
TRRR_MAPPING_TYPE="NHS_ID_UPDATE"
DB_USERNAME="sa"
DB_ENCRYPT="No"
DB_TRUST_SERVER_CERTIFICATE="Yes"

WORKFLOW_ID="lims-to-trrr"
MICROSERVICE_ID="db_sender_trrr"
HEALTH_BOARD="SHARED"
PEER_SERVICE="TRRR"
HEALTH_CHECK_HOST="0.0.0.0"
HEALTH_CHECK_PORT=9000
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
