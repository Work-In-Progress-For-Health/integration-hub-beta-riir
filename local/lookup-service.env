# Lookup service (spec/20-lookup-service.md). Phase 1: not production ready.
#
# LOCAL runs with authentication off (spec §2.8). Outside LOCAL the service
# refuses to start with this, except DEV/TST with LOOKUP_AUTH_DISABLED_ACK set.
ENVIRONMENT="LOCAL"
LOOKUP_AUTH_DISABLED="true"
LOG_LEVEL="INFO"
# Local only: the tables loaded at start-up, mounted from local/lookup-seed by
# docker-compose.yml (spec §7.5). Unset in every deployed environment, where
# the service starts with no tables.
LOOKUP_SEED_DIR="/seed"
# COSMOS_ENDPOINT is deliberately absent: the Cosmos store is not ported and
# the service refuses to start with it set (§2.5).
LOOKUP_DEFAULT_TTL_SECONDS="300"
LOOKUP_MAX_UPLOAD_MB="50"
