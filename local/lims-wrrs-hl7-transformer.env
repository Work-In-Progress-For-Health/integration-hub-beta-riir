SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
# NOTE: upstream publishes LIMS to this TOPIC. Here `lims-soap-hl7-server.env`
# still writes a QUEUE of the same name (the LIMS queue-to-topic migration is
# not ported), so nothing feeds this subscription locally until it is.
INGRESS_TOPIC_NAME="local-inthub-lims-transformer-ingress"
INGRESS_SUBSCRIPTION_NAME="local-inthub-lims-wrrs-transformer-sub"
INGRESS_SESSION_ID="lims-to-mpi"
EGRESS_TOPIC_NAME="local-inthub-lims-wrrs-classified"
EGRESS_SESSION_ID="lims-to-wrrs"
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
WORKFLOW_ID="lims-to-wrrs"
MICROSERVICE_ID="lims_wrrs_hl7_transformer"
HEALTH_BOARD="WLIMS"
PEER_SERVICE="WRRS"

# Optional overrides for the MappingType application property values (must match the
# classified-topic subscription filters). spec/09-transformers.md §10.7.
# MAPPING_TYPE_NHS_ID_UPDATE="LIMS_NHS_ID_UPDATE"
# MAPPING_TYPE_A40="ADT_A40"
