# The generic db-sender configured as upstream's db_sender_trrr, merge instance
# (spec/10-senders.md section 7.10; upstream #458): every A40, as the four parameters of
# dbo.TRRRIDMerge. An A40 also reaches the NHS-ID-update instance, so it makes two TRRR calls.
SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
INGRESS_TOPIC_NAME="local-inthub-lims-hl7-input"
INGRESS_SUBSCRIPTION_NAME="local-inthub-lims-trrr-merge-sender-sub"
INGRESS_SESSION_ID="lims-soapserver"

DB_SERVER="sqledge"
DB_PORT=1433
DB_NAME="Clinical_Results"
DB_STORED_PROCEDURE="dbo.TRRRIDMerge"
DB_PROCEDURE_TYPE="trrr"
TRRR_MAPPING_TYPE="MERGE"
DB_USERNAME="sa"
DB_ENCRYPT="No"
DB_TRUST_SERVER_CERTIFICATE="Yes"

WORKFLOW_ID="lims-to-trrr"
MICROSERVICE_ID="db_sender_trrr_merge"
HEALTH_BOARD="SHARED"
PEER_SERVICE="TRRR"
HEALTH_CHECK_HOST="0.0.0.0"
HEALTH_CHECK_PORT=9000
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
