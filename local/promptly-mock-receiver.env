# Promptly mock - the http-mock-receiver serving the $process-message async API
# (spec/11-mock-receivers.md section 3.10). Log-only: no EGRESS_QUEUE_NAME, so
# accepted Bundles are not forwarded. Set the three below to forward them to a
# queue and read them back in an end-to-end test.
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN

# SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
# EGRESS_QUEUE_NAME=
# EGRESS_SESSION_ID=
