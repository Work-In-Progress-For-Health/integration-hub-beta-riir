# Promptly mock - the http-mock-receiver serving the $process-message async API
# (spec/11-mock-receivers.md section 3.10). Accepted Bundles are forwarded to a
# session queue (like every queue but the two of spec/01 section 4.1) so an end-to-end test can read them back (section 3.10.1).
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN

SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://sb-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
EGRESS_QUEUE_NAME=local-inthub-promptly-mock-receiver
EGRESS_SESSION_ID=wpas-to-proms
