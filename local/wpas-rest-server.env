HOST="0.0.0.0"
PORT="8080"
LOG_LEVEL=INFO
AZURE_LOG_LEVEL=WARN
WORKFLOW_ID="wpas-to-proms"
MICROSERVICE_ID="wpas_rest_server"
HEALTH_BOARD="PROMS"
PEER_SERVICE="MPI"
